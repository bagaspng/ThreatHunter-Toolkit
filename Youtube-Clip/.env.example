# ═══════════════════════════════════════════════════════════
# 🔧 Heatmap Clipper — Configuration
# Copy ke `.env` lalu isi sesuai kebutuhan.
# ═══════════════════════════════════════════════════════════

# 🔒 Password proteksi (kosong = akses bebas / lokal)
APP_PASSWORD=

# 📁 Lokasi SQLite + folder clips
DATA_DIR=data

# ═══════════════════════════════════════════════════════════
# 🧠 Whisper Notebook (opsional) — pindahkan transkripsi ke GPU
# Colab/Kaggle biar beban lokal ringan.
#
# Cara pakai:
#   1. Buka notebooks/whisper_server.ipynb di Google Colab.
#   2. Set runtime ke GPU, jalankan cell, tunggu ~2-5 menit.
#   3. Salin BASE_URL + API_KEY yang dicetak ke sini.
#   4. Kalau kosong → backend pakai faster-whisper lokal (CPU).
#
# Catatan: URL tunnel sementara, berubah tiap restart notebook.
# ═══════════════════════════════════════════════════════════

# 🌐 Base URL dari notebook whisper (Cloudflare Tunnel)
# Contoh: https://xxxx-xxxx-xxxx.trycloudflare.com
WHISPER_BASE_URL=

# 🔑 API Key (default dari notebook: sk-whisper-local)
WHISPER_API_KEY=

# 🤖 Model whisper untuk fallback lokal (kalau WHISPER_BASE_URL kosong)
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
